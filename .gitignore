# 运行时状态（督办台账等），不入库
data/

# 本地密钥
config/local.env
# 推送通道配置里有 webhook key 和邮箱授权码，只提交 notify.example.json
config/notify.json
# 腾讯会议的企业凭证（SecretKey 等同密码），只提交 wemeet.example.json
config/wemeet.json

# Python
__pycache__/
*.py[cod]

# 生成物：内嵌 data/ 快照的单文件工作台，数据一变整文件重写，不入库
docs/workbench.html

# 演示分镜图：由 docs/演示视频分镜单.md 经 tools/gen_storyboard.py 逐张重出，
# 体积大（近 4M）且属于生成物；.rar 是同批图的打包，一并排除
docs/分镜图/
docs/分镜图.rar

# 本地助手的工作区（记忆与临时文件），不属于项目代码
.workbuddy/

# 一次性调试产物（curl 回包、出图时用的 headless 浏览器 profile），可随时重跑
.tmp_*

# 离线快照导出物（每导一次整份重写，不入库）
dist/
